# Copy to .env.local and fill in.

# NOTE: This project builds as a fully static site (next.config.mjs -> output: 'export').
# There are no server API routes or admin dashboard. Leads are captured client-side
# via prefilled WhatsApp messages (opens wa.me chat) on the contact / request-car / compare forms.
# SMTP (nodemailer), /api/leads, and /admin are NOT used in this build.

# ── Redis cache (optional but recommended) ─────────────────────────────
# Upstash (free tier): console.upstash.com -> Create database -> copy the rediss:// URL
# Used ONLY as an optional build-time catalog cache (src/lib/redis.ts).
# If unset, caching is silently disabled and the in-memory catalog cache is used instead.
REDIS_URL=

# ── Google Analytics 4 (optional) ─────────────────────────────────────
# Set to your GA4 measurement ID (e.g. G-XXXXXXXXXX) to enable analytics.
NEXT_PUBLIC_GA_ID=

# ── Meta Pixel (optional) ────────────────────────────────────────────
# Set to your Meta Pixel ID to enable Facebook/Meta tracking.
NEXT_PUBLIC_META_PIXEL=

# ── Yandex Metrica (optional) ────────────────────────────────────────
# Set to your Yandex Metrica counter ID to enable Yandex tracking.
NEXT_PUBLIC_YANDEX_ID=

# ── Google Search Console (optional) ──────────────────────────────────
# Set to your GSC verification token to enable site verification.
NEXT_PUBLIC_GSC_TOKEN=
